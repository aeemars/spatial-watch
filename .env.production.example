# ═══════════════════════════════════════════════════════════
# Spatial Watch — Production Environment Configuration
# ═══════════════════════════════════════════════════════════

PORT=8080

# MongoDB Atlas URI (ensure Atlas IP Access List allows 0.0.0.0/0 or server IP)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=spatialwatch

# Public Production URL (must be https:// for WebXR & hand tracking)
PUBLIC_BASE_URL=https://spatialwatch.yourdomain.com

# Production Cookie & CORS Security
# COOKIE_SECURE: Must be true in production over HTTPS
COOKIE_SECURE=true
# COOKIE_DOMAIN: Leave empty for host-only cookies, or set to .yourdomain.com for shared subdomains
COOKIE_DOMAIN=
# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed origins (e.g. https://spatialwatch.pages.dev,https://yourdomain.com)
CORS_ALLOWED_ORIGINS=https://spatialwatch.yourdomain.com
SESSION_DURATION_DAYS=30

# Cloudflare R2 Object Storage Credentials
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="spatialwatch-media"
# R2 Public Stream URL (Cloudflare r2.dev domain or custom streaming domain)
R2_PUBLIC_URL=""
