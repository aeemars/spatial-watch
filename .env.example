PORT=8080
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=spatialwatch
PUBLIC_BASE_URL=http://localhost:8080

# Session & Security Settings
# COOKIE_SECURE: Set to true in production over HTTPS. Defaults to false for plain local HTTP development.
COOKIE_SECURE=false
# COOKIE_DOMAIN: Optional custom cookie domain (e.g. .example.com). Leave empty for host-only cookies.
COOKIE_DOMAIN=
# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed origins for cross-origin credentials (e.g. https://app.spatialwatch.com).
CORS_ALLOWED_ORIGINS=
# SESSION_DURATION_DAYS: Inactivity lifetime of guest session in days (default: 30).
SESSION_DURATION_DAYS=30
